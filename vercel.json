{
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/classify",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/score",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/run-health-check",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/publish?view=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
